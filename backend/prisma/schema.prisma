generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  roleId       String
  role         Role           @relation(fields: [roleId], references: [id])
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastLoginAt  DateTime?

  notifications Notification[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  managedWarehouses Warehouse[] @relation("WarehouseManager")
  stockTransactions StockTransaction[]
  inventoryAdjustments InventoryAdjustment[]
  requestedTransfers StockTransfer[] @relation("TransferRequester")
  approvedTransfers StockTransfer[] @relation("TransferApprover")
  receivedTransfers StockTransfer[] @relation("TransferReceiver")
  stockReservations StockReservation[]
  reservations Reservation[] @relation("ReservationRequester")
  stockCounts  StockCount[] @relation("StockCountCreator")
  stockCountReviews StockCount[] @relation("StockCountReviewer")
  stockCountApprovals StockCount[] @relation("StockCountApprover")
  reconciliations InventoryReconciliation[] @relation("ReconciliationApprover")
  reconciliationExecutions InventoryReconciliation[] @relation("ReconciliationExecutor")

  @@index([roleId])
  @@index([isActive])
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model Warehouse {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  location    String?
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?
  phone       String?
  email       String?
  managerId   String?
  manager     User?    @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  capacity    Int?
  status      String   @default("ACTIVE")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventories            Inventory[]
  transfersOut           StockTransfer[]       @relation("SourceTransfers")
  transfersIn            StockTransfer[]       @relation("DestinationTransfers")
  reservations           Reservation[]
  inventoryAdjustments   InventoryAdjustment[]
  stockTransactions      StockTransaction[]
  stockCounts            StockCount[]
  reconciliations        InventoryReconciliation[]

  @@index([name])
  @@index([status])
  @@index([managerId])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([name, parentId])
  @@index([name])
  @@index([parentId])
  @@index([status])
}

model Product {
  id          String   @id @default(uuid())
  sku         String   @unique
  barcode     String?  @unique
  name        String
  description String?
  brand       String?
  unit        String   @default("unit")
  weight      Decimal? @db.Decimal(12, 3)
  length      Decimal? @db.Decimal(12, 3)
  width       Decimal? @db.Decimal(12, 3)
  height      Decimal? @db.Decimal(12, 3)
  costPrice   Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice Decimal @default(0) @db.Decimal(12, 2)
  price       Decimal  @default(0) @db.Decimal(10, 2)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  status      String   @default("ACTIVE")
  reorderLevel Int     @default(0)
  maximumStockLevel Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventories          Inventory[]
  stockTransactions    StockTransaction[]
  transferItems        StockTransferItem[]
  reservations         StockReservation[]
  reservationItems      ReservationItem[]
  inventoryAdjustments InventoryAdjustment[]
  purchaseOrderItems   PurchaseOrderItem[]
  returns              Return[]
  stockCountItems      StockCountItem[]
  reconciliationItems  InventoryReconciliationItem[]

  @@index([name])
  @@index([categoryId])
  @@index([status])
  @@index([brand])
}

model Inventory {
  id                String    @id @default(uuid())
  warehouseId       String
  productId         String
  quantityOnHand    Int       @default(0)
  quantityReserved  Int       @default(0)
  reorderLevel      Int       @default(0)
  maximumStockLevel Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  stockTransactions StockTransaction[]

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
}

model StockTransaction {
  id              String   @id @default(uuid())
  inventoryId     String
  productId       String
  warehouseId     String
  transactionType String
  quantity        Int
  quantityBefore  Int
  quantityAfter   Int
  referenceType   String?  // TRANSFER, ORDER, RETURN
  referenceId     String?
  reason          String
  notes           String?
  performedBy     String
  createdAt       DateTime @default(now())

  inventory       Inventory @relation(fields: [inventoryId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  performer       User @relation(fields: [performedBy], references: [id])

  @@index([inventoryId, createdAt])
  @@index([productId, warehouseId])
  @@index([transactionType])
  @@index([createdAt])
}

model StockTransfer {
  id                     String              @id @default(uuid())
  transferNumber         String              @unique
  sourceWarehouseId      String
  destinationWarehouseId String
  requestedById          String
  approvedById           String?
  receivedById           String?
  status                 String              @default("DRAFT")
  requestedAt            DateTime            @default(now())
  approvedAt             DateTime?
  shippedAt              DateTime?
  receivedAt             DateTime?
  rejectionReason        String?
  cancellationReason     String?
  notes                  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  sourceWarehouse        Warehouse           @relation("SourceTransfers", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse   Warehouse           @relation("DestinationTransfers", fields: [destinationWarehouseId], references: [id])
  requestedBy            User                @relation("TransferRequester", fields: [requestedById], references: [id])
  approvedBy             User?               @relation("TransferApprover", fields: [approvedById], references: [id])
  receivedBy             User?               @relation("TransferReceiver", fields: [receivedById], references: [id])
  items                  StockTransferItem[]
  reservations            StockReservation[]

  @@index([status])
  @@index([sourceWarehouseId, createdAt])
  @@index([destinationWarehouseId, createdAt])
  @@index([requestedById])
  @@index([createdAt])
}

model StockTransferItem {
  id              String        @id @default(uuid())
  transferId      String
  productId       String
  requestedQuantity Int
  shippedQuantity Int @default(0)
  receivedQuantity Int @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transfer        StockTransfer @relation(fields: [transferId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
}

model StockReservation {
  id          String   @id @default(uuid())
  productId   String
  warehouseId String
  quantity    Int
  userId      String?
  transferId  String?
  status      String   // ACTIVE, FULFILLED, CANCELLED
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id])
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  transfer    StockTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@index([transferId, status])
}

model Reservation {
  id                String   @id @default(uuid())
  reservationNumber String   @unique
  warehouseId       String
  reservationType   String
  status            String   @default("PENDING")
  referenceType     String?
  referenceId       String?
  requestedById     String
  expiresAt         DateTime?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])
  requestedBy       User @relation("ReservationRequester", fields: [requestedById], references: [id])
  items             ReservationItem[]

  @@index([warehouseId, status])
  @@index([reservationType])
  @@index([referenceType, referenceId])
  @@index([requestedById])
  @@index([expiresAt])
  @@index([createdAt])
}

model ReservationItem {
  id                String   @id @default(uuid())
  reservationId     String
  productId         String
  requestedQuantity Int
  reservedQuantity  Int      @default(0)
  consumedQuantity  Int      @default(0)
  releasedQuantity  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  reservation       Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [id])

  @@unique([reservationId, productId])
  @@index([reservationId])
  @@index([productId])
}

model InventoryAdjustment {
  id          String   @id @default(uuid())
  warehouseId String
  productId   String
  quantity    Int
  reason      String
  notes       String?
  type        String
  performedBy String?
  createdAt   DateTime @default(now())

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  performer   User?     @relation(fields: [performedBy], references: [id])
}

model Supplier {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  website        String?
  address        String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  paymentTerms   String?
  status         String          @default("ACTIVE")
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@index([status])
}

model PurchaseOrder {
  id         String              @id @default(uuid())
  supplierId String
  status     String              // DRAFT, ORDERED, RECEIVED, CANCELLED
  total      Decimal             @db.Decimal(10, 2)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  items      PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitPrice       Decimal       @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
}

model Return {
  id          String   @id @default(uuid())
  productId   String
  quantity    Int
  reason      String
  status      String   // PENDING, APPROVED, REJECTED, PROCESSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model StockCount {
  id                String              @id @default(uuid())
  countNumber       String              @unique
  warehouseId       String
  countType         String              // FULL, PARTIAL, CYCLE, SPOT_CHECK
  status            String              @default("DRAFT")
  startedAt         DateTime?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  approvedAt        DateTime?
  completedAt       DateTime?
  createdById       String
  reviewedById      String?
  approvedById      String?
  rejectionReason   String?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  warehouse         Warehouse           @relation(fields: [warehouseId], references: [id])
  createdBy         User                @relation("StockCountCreator", fields: [createdById], references: [id])
  reviewedBy        User?               @relation("StockCountReviewer", fields: [reviewedById], references: [id])
  approvedBy        User?               @relation("StockCountApprover", fields: [approvedById], references: [id])
  items             StockCountItem[]
  reconciliation    InventoryReconciliation?

  @@index([countNumber])
  @@index([warehouseId, status])
  @@index([status])
  @@index([countType])
  @@index([createdAt])
  @@index([createdById])
}

model StockCountItem {
  id                String              @id @default(uuid())
  stockCountId      String
  productId         String
  systemQuantity    Int
  countedQuantity   Int?
  varianceQuantity  Int                 @default(0)
  variancePercentage Float              @default(0)
  severity          String              @default("NONE") // NONE, LOW, MEDIUM, HIGH, CRITICAL
  notes             String?
  countedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  stockCount        StockCount          @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id])

  @@unique([stockCountId, productId])
  @@index([stockCountId])
  @@index([productId])
  @@index([severity])
}

model InventoryReconciliation {
  id                  String                      @id @default(uuid())
  reconciliationNumber String                    @unique
  stockCountId        String                    @unique
  warehouseId         String
  status              String                    @default("PENDING") // PENDING, APPROVED, EXECUTED, FAILED, CANCELLED
  approvedById        String?
  executedById        String?
  approvedAt          DateTime?
  executedAt          DateTime?
  totalIncrease       Int                       @default(0)
  totalDecrease       Int                       @default(0)
  totalVariance       Int                       @default(0)
  notes               String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  stockCount          StockCount                @relation(fields: [stockCountId], references: [id])
  warehouse           Warehouse                 @relation(fields: [warehouseId], references: [id])
  approvedBy          User?                     @relation("ReconciliationApprover", fields: [approvedById], references: [id])
  executedBy          User?                     @relation("ReconciliationExecutor", fields: [executedById], references: [id])
  items               InventoryReconciliationItem[]

  @@index([reconciliationNumber])
  @@index([stockCountId])
  @@index([warehouseId])
  @@index([status])
}

model InventoryReconciliationItem {
  id                    String                      @id @default(uuid())
  reconciliationId      String
  productId             String
  systemQuantity        Int
  countedQuantity       Int
  adjustmentQuantity    Int
  adjustmentType        String                      // INCREASE, DECREASE, NO_CHANGE
  reason                String
  createdAt             DateTime                    @default(now())

  reconciliation        InventoryReconciliation     @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  product               Product                     @relation(fields: [productId], references: [id])

  @@index([reconciliationId])
  @@index([productId])
}
