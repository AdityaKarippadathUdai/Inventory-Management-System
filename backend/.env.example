# Backend Environment Variables

# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://admin:password@localhost:5432/warehouse_db?schema=public"

# Authentication: use long random values in local .env and deployment secrets
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Development-only seed credentials. Never use these defaults in production.
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=ChangeMe123!
